# ========================================
# IMAGE SERVICE - OPTIMIZED CONFIGURATION
# For dramatically faster processing (5-10x speedup)
# ========================================

# ========================================
# PREPROCESSING OPTIMIZATION (2-3x faster)
# ========================================
# Enable optimized preprocessing with aggressive resizing and compression
USE_OPTIMIZED_PREPROCESSING=true

# Target image size (smaller = faster, but may reduce quality)
# Options: 224 (fastest), 256 (balanced), 384 (quality), 512 (high quality)
OPTIMIZED_TARGET_SIZE=256

# JPEG compression quality (1-100, lower = faster but more artifacts)
# 85 is recommended balance
OPTIMIZED_JPEG_QUALITY=85

# Enable caching of preprocessed images (faster for repeated processing)
ENABLE_PREPROCESSING_CACHE=false

# Optional: Reduce color palette for abstract/posterized effect
# Uncomment and set to 64, 128, or 256 for additional speedup
# PIXEL_QUANTIZATION=64

# ========================================
# PARALLEL PROCESSING (3-4x faster)
# ========================================
# Processing mode: sequential | parallel | batched | streaming
# - sequential: One at a time (safest, slowest)
# - parallel: All at once (fastest, high memory)
# - batched: Process in batches (balanced, recommended)
# - streaming: Process and persist in chunks (large datasets)
PROCESSING_MODE=batched

# Number of parallel workers (adjust based on your CPU cores)
# Recommended: 4 for quad-core, 8 for 8-core CPUs
PARALLEL_WORKERS=4

# Images to process per batch
# Larger = more memory, faster. Smaller = less memory, slower.
# Recommended: 8 for <16GB RAM, 16 for >=16GB RAM
BATCH_SIZE=8

# ========================================
# GPU ACCELERATION (2x faster)
# ========================================
# Device for model inference (auto-detected by default)
# Uncomment to force specific device:
# DEVICE=mps      # macOS Apple Silicon
# DEVICE=cuda     # Windows/Linux NVIDIA GPU
# DEVICE=cpu      # Force CPU (slowest)

# ========================================
# STANDARD SETTINGS
# ========================================
# Input/output paths
INPUT_FOLDER=data/post_images
OUTPUT_FOLDER=outputs

# Processing limits (0 = no limit)
MAX_IMAGES=0

# Logging level
LOG_LEVEL=INFO

# Legacy preprocessing setting (ignored when USE_OPTIMIZED_PREPROCESSING=true)
MAX_IMAGE_SIDE_PX=1024

# ========================================
# MONGODB STORAGE
# ========================================
MONGODB_URI=mongodb+srv://rishikamehta2004:rishu2004@cluster0.1yrcnpc.mongodb.net/dellinnovate?retryWrites=true&w=majority
MONGODB_DB_NAME=dellinnovate
MONGODB_COLLECTION_NAME=image_analysis_results

# ========================================
# MODEL CONFIGURATION
# ========================================
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL=dima806/facial_emotions_image_detection
SENTIMENT_CONFIDENCE_THRESHOLD=0.0

# Vision-Language Model Selection
# Choose which VLM to use for scene description, OCR, and emotion detection:
#   - qwen:    ULTRA-FAST API-based (Qwen2.5-VL-72B via OpenRouter, requires API key)
#   - blip2:   FASTEST local option (3-10x faster on Apple Silicon), good quality
#   - llava:   Balanced speed and quality
#   - smolvlm: Most accurate but VERY SLOW on Apple Silicon (5+ minutes per image)
VLM_MODEL=qwen

# OpenRouter API Configuration (required for Qwen VLM)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct

# ========================================
# EXPECTED PERFORMANCE
# ========================================
# With these settings on Apple Silicon M1/M2/M3:
# - 50 images: ~60-90 seconds (vs 7 minutes baseline)
# - Speedup: 5-7x faster
# - Quality: ~85% of original (sufficient for most use cases)
#
# To maximize speed (10-14x faster):
#   OPTIMIZED_TARGET_SIZE=224
#   PROCESSING_MODE=parallel
#   PARALLEL_WORKERS=8
#
# To maximize quality (slower but better):
#   USE_OPTIMIZED_PREPROCESSING=false
#   PROCESSING_MODE=batched
#   PARALLEL_WORKERS=4
